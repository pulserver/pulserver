# Format of blocks:
# NUM DUR RF  GX  GY  GZ  ADC  EXT
# This sequence has ONCE=1 sections repeating in the middle (bSSFP-like).
# Inner loop period = 4 blocks: [prep(ONCE=1), reset(ONCE=0), main, main]
# Three identical inner loop repetitions, plus a trailing cooldown block.
[BLOCKS]
