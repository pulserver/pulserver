# Pulseq sequence file
# Hand-authored fixture for pulserver MODULE-label ctests (test_module_labels.c)
# MODULE 1 appears twice (blocks 1 and 3) with DIFFERENT durations (100us vs
# 200us) -- an intentionally ill-formed label placement that
# pulseg_get_modules() must hard-fail with PULSEG_ERR_MODULE_STRUCTURAL_MISMATCH,
# not silently average/dedup.

[VERSION]
major 1
minor 5
revision 1

[DEFINITIONS]
AdcRasterTime 1e-07
BlockDurationRaster 1e-05
GradientRasterTime 1e-05
RadiofrequencyRasterTime 1e-06

# Format of blocks:
# NUM DUR RF  GX  GY  GZ  ADC  EXT
[BLOCKS]
1 10   0   0   0   0  0  1
2 5    0   0   0   0  0  2
3 20   0   0   0   0  0  3

# id type ref next_id
[EXTENSIONS]
1 1 1 0
2 1 2 0
3 1 3 0

extension LABELSET 1
1 1 MODULE
2 2 MODULE
3 1 MODULE

[SIGNATURE]
Type md5
Hash 0000000000000000000000000000000
