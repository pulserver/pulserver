# Readability-first C/C++ style: clean vertical structure over alignment tricks.
#
# The intent is code with the visual clarity of well-formatted Python while
# staying idiomatic C/C++.  Two rules carry most of the weight:
#   - never align continuation lines against an opening bracket (long names
#     would otherwise push arguments far to the right), and
#   - once a call or declaration does not fit, put every argument on its own
#     line rather than packing as many as fit per line.
#
# csrc/ is ANSI C (C89): declarations go at the start of a block.  Prefer
# nested `{ ... }` scopes that group variables with the phase of code using
# them over one large declaration section at the top of a function.

BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# AlwaysBreak, not DontAlign: both refuse to align continuation lines against
# the bracket, but only AlwaysBreak also puts the FIRST argument on its own
# line, which is the shape we want for a wrapped argument list:
#     int process(
#         int first_argument,
#         int second_argument);
AlignAfterOpenBracket: AlwaysBreak
BinPackParameters: false
BinPackArguments: false
BreakBeforeTernaryOperators: true
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false

# Braces on their own line, the convention already used throughout csrc/.
BreakBeforeBraces: Allman

# Keep short constructs readable rather than compact.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Do not let alignment padding drift as neighbouring lines change.
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: DontAlign
AlignTrailingComments: true
AlignEscapedNewlines: DontAlign

PointerAlignment: Right
SpaceAfterCStyleCast: false
SortIncludes: false
ReflowComments: false

# Long boolean expressions read better broken after the operator.
BreakBeforeBinaryOperators: None

# Never split the return type onto its own line -- LLVM's default penalty is
# low enough that it does, which reads as a stray declaration.
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 100000

IndentCaseLabels: false
ContinuationIndentWidth: 4
Cpp11BracedListStyle: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
